# Copy to `.env` in this directory (deploy/compose/ — where compose looks for it)
# to override the compose defaults. All values below are the built-in defaults
# (docker-compose.yml uses ${VAR:-default}). `make up` creates `.env` with a
# generated PGLENS_ADMIN_PASSWORD, and `make register` adds PGLENS_AGENT_TOKEN —
# `.env` is git-ignored; never put real secrets in this example file.

# Which released images `docker compose up` pulls (ghcr.io/prateek-arora/pglens-*).
PGLENS_VERSION=0.1.0-rc

# Shared superuser for both databases. Their ports listen on 127.0.0.1 only; on a shared host set
# your own password here BEFORE the first `make up` (it is applied when the data volumes are made).
POSTGRES_USER=pglens
POSTGRES_PASSWORD=pglens

# Database names.
MONITORED_DB=pglens_demo
METADATA_DB=pglens_meta

# Host ports on 127.0.0.1 (container side is always 5432). Chosen off 5432 to
# avoid clashing with a local Postgres.
MONITORED_PORT=5433
METADATA_PORT=5434

# HTTP API (loopback only) and its login (ADR-0044). AUTH_MODE=none: a single
# person on their own machine only.
PGLENS_HTTP_PORT=8080
PGLENS_AUTH_MODE=required

# Extra names for the gRPC server's dev certificate, for agents that dial it by
# another name (server, localhost, 127.0.0.1 and host.docker.internal are always
# included). Changing them re-issues the certificates: copy the new ca.pem to agents.
PGLENS_TLS_EXTRA_SANS=

# The dashboard (loopback only) and the agents' gRPC port (the one port open to the network).
PGLENS_DASHBOARD_PORT=3000
PGLENS_GRPC_PORT=9090

# PgLens's own store: per-sample rows older than this many days are deleted hourly (the hourly
# rollup the dashboard reads is kept). At least 31.
PGLENS_RETENTION_RAW_DAYS=35

# Plain-language explanations by a model (off: PgLens's own template, exact numbers, no model).
# Any OpenAI-compatible endpoint: `make llm-up` (Ollama in Docker) is the default URL; native Ollama
# is http://host.docker.internal:11434/v1. A hosted API also needs its key and ALLOW_REMOTE=true —
# check its data terms first. Status: dashboard → Settings. Guide: docs/operations.md §6.
PGLENS_EXPLAIN_ENABLED=false
PGLENS_LLM_URL=http://llm:11434/v1
PGLENS_LLM_MODEL=qwen3.5:4b
# PGLENS_LLM_API_KEY=
PGLENS_LLM_ALLOW_REMOTE=false
