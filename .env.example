# Copy to `.env` to override the compose defaults. All values below are the
# built-in defaults (docker-compose.yml uses ${VAR:-default}), so `.env` is
# entirely optional for local dev.

# Shared superuser for both demo databases (local dev only — not a real secret).
POSTGRES_USER=pglens
POSTGRES_PASSWORD=pglens

# Database names.
MONITORED_DB=pglens_demo
METADATA_DB=pglens_meta

# Host ports (container side is always 5432). Chosen off 5432 to avoid clashing
# with a local Postgres.
MONITORED_PORT=5433
METADATA_PORT=5434
