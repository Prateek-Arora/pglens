  "narrative": {
    "northStar": "The Drafting Sheet",
    "overview": "PgLens draws query data the way an engineering drawing draws a part: measured in solid ink, planner estimates dashed or hatched. Content lies on white sheets over a cool drafting film (light) or blueprint navy (dark), following the OS. Color is never decoration; each hue has one job.",
    "keyCharacteristics": [
      "Solid = measured, dashed/hatched = planner estimate, in text, bars and plan nodes alike.",
      "To-scale dimension bars with an end tick, read against a round-graduation ruler.",
      "One ink per metric everywhere: total time, mean time, calls.",
      "Syntax-colored SQL in JetBrains Mono at 13 px; interface in IBM Plex Sans with tabular numerals.",
      "White sheets with a soft offset shadow on a cool film; blueprint navy in dark mode.",
      "Plan problems are redlines: a dashed vermilion outline and a numbered balloon."
    ],
    "rules": [
      {
        "name": "The One Job Rule",
        "body": "Every hue has exactly one meaning, the same on every page.",
        "section": "colors"
      },
      {
        "name": "The One Ink Per Metric Rule",
        "body": "Total time, mean time and calls always print in their own ink; the sorted metric is bold, never a different color.",
        "section": "colors"
      },
      {
        "name": "The Hatch, Don't Tint Rule",
        "body": "An estimate in a bar is hatched in its ink, never a paler tint; a measurement is solid.",
        "section": "colors"
      },
      {
        "name": "The SQL Is Code Rule",
        "body": "A query never renders as plain mono text: it goes through SqlInline or SqlBlock.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Numerals are tabular everywhere.",
        "section": "typography"
      },
      {
        "name": "The One Sheet Rule",
        "body": "Sheets never nest inside sheets; inner grouping uses rules or a code well.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do render every number through `<Measured>`, `<Estimate>` or `<Count>`. Estimates always carry the dashed underline and \"est.\".",
      "Do print total time, mean time and calls in their metric inks wherever they appear.",
      "Do put content on a sheet, and inner structure in rules or code wells.",
      "Do keep inputs, selects and buttons at 36 px, with help text below the row.",
      "Do screenshot every route at 1440 and 390 px, in both themes, and run axe before calling visual work done."
    ],
    "donts": [
      "Don't show a query as plain mono text; use `SqlInline` or `SqlBlock`.",
      "Don't put a grid or pattern on the page background.",
      "Don't use a pale tint to mean \"estimate\"; hatch it.",
      "Don't fill a plan problem with a tinted alert panel; draw the redline.",
      "Don't add a color without a role, or reuse a role color for decoration.",
      "Don't let \"Planner-validated\" read as \"safe\"; the measure-first step stays beside every validated suggestion."
    ]
  }
}
